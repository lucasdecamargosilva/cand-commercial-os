# ── Usuarios do painel ────────────────────────────────────────
# Opcao A (recomendada): tabela no Supabase. Rode sql/001_usuarios.sql.
SUPABASE_URL=https://seu-supabase.easypanel.host
SUPABASE_SERVICE_KEY=service_role_key_aqui
# SUPABASE_USERS_TABLE=usuarios   # opcional, padrao "usuarios"

# Opcao B (fallback): usado APENAS se SUPABASE_URL/SUPABASE_SERVICE_KEY
# estiverem vazios. JSON em UMA linha. Prefira senha_hash a pass.
# APP_USERS={"lucas":{"senha_hash":"scrypt$...","role":"owner","nome":"Lucas"}}

# ── Sessao ────────────────────────────────────────────────────
# Assina o token de login (12h). Gere um novo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=troque-isto-por-uma-string-aleatoria-longa

# ── Integracoes ───────────────────────────────────────────────
SHOPIFY_STORE_DOMAIN=candstore-br.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_xxx
ANTHROPIC_API_KEY=sk-ant-xxx

PORT=3000
